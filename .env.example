# Copy to .env. Defaults run a full demo with mock UAC/ServiceNow/Teams/phone/email.

APP_ENV=dev                      # dev | prod (prod refuses weak SECRET_KEY / missing API_TOKEN)
PUBLIC_BASE_URL=http://localhost:8000   # used in Teams/email acknowledge links
SECRET_KEY=change-me-to-a-random-string-of-32-plus-chars   # python -c "import secrets;print(secrets.token_urlsafe(48))"
API_TOKEN=                       # dashboard/API bearer token (required in prod)
DATABASE_URL=sqlite+aiosqlite:///./data/oncallpilot.db
# DATABASE_URL=postgresql+asyncpg://oncallpilot:oncallpilot@localhost:5432/oncallpilot

# Demo speed: 60 = a policy minute lasts one second, so a full ladder runs in about a minute. Use 1 in prod.
TIME_SCALE=60
MOCK_ANSWER_PROBABILITY=0.0      # chance a mock call is answered
MOCK_RING_SECONDS=6

# --- AI (optional; without a key, keyword rules do the triage) -----------------------------
LLM_API_KEY=                     # free key: https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct   # for screenshot reading

# --- Providers: mock or real -----------------------------------------------------------------
CHAT_PROVIDER=mock               # mock | teams_webhook
VOICE_PROVIDER=mock              # mock | teams_graph
EMAIL_PROVIDER=mock              # mock | smtp | graph
ONCALL_PROVIDER=mock             # mock | servicenow

# Teams channel webhooks (Workflows: "Post to a channel when a webhook request is received"), per team
PAYMENTS_TEAMS_WEBHOOK=
CDP_TEAMS_WEBHOOK=
BATCHOPS_TEAMS_WEBHOOK=

# Stonebranch UAC
UAC_WEBHOOK_SECRET=              # UAC webhook sends it in the X-Webhook-Token header
UAC_BASE_URL=                    # e.g. https://uac.example.com/uc  (enables log fetch + poller)
UAC_USERNAME=
UAC_PASSWORD=
UAC_POLL_ENABLED=false
UAC_POLL_SECONDS=60

# ServiceNow
SERVICENOW_INSTANCE=             # e.g. https://acme.service-now.com
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
INCIDENT_PROVIDER=mock           # mock | servicenow | off  (the failure's ServiceNow incident)
SERVICENOW_INCIDENT_MODE=find    # find = ServiceNow already raises one for UAC failures; create = OnCallPilot raises it
SERVICENOW_QUEUE_GROUP=          # SysOps queue the UAC incidents land in (narrows the search), e.g. SysOps Batch Monitoring
SERVICENOW_MATCH_HOURS=12
SERVICENOW_TRANSFER_WHEN=acknowledged   # acknowledged (or nobody answered) | notified (right after the Teams alert)

# Microsoft Graph (Teams calls and/or mail)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
TEAMS_CALL_SOURCE_ID=            # Teams Phone resource account (application instance) id
RING_TIMEOUT_SECONDS=45

# Email
MAIL_FROM=oncallpilot@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
